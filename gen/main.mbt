async fn main {
  let args = @env.args()
  let mut dist = ""
  let mut output = "src/embedded.mbt"
  // args[0] 是程序路径，args[1] 开始是用户参数
  let mut i = 1
  while i < args.length() {
    if args[i] == "-o" && i + 1 < args.length() {
      i = i + 1
      output = args[i]
    } else if dist.is_empty() {
      dist = args[i]
    }
    i = i + 1
  }
  if dist.is_empty() {
    @stdio.stderr.write("usage: moon run gen -- <dist-dir> [-o output]\n")
    @stdio.stderr.write("  default output: src/embedded.mbt\n")
    return
  }
  let is_dir = try { @fs.kind(dist) is @fs.Directory } catch { _ => false }
  if !is_dir {
    @stdio.stderr.write("error: not a directory: " + dist + "\n")
    return
  }
  let files = collect_files(dist)
  let lines : Array[String] = []
  lines.push("// Code generated by moon-embed/gen; DO NOT EDIT.")
  lines.push("// Source: " + dist)
  lines.push("")
  lines.push("pub let EMBED_PATHS : Array[String] = [")
  for f in files {
    let rel = relativize(dist, f)
    lines.push("  \"/" + rel + "\",")
  }
  lines.push("]")
  lines.push("")
  lines.push("pub let EMBED_DATA : Array[String] = [")
  for f in files {
    let raw = @fs.read_file(f)
    let b64 = @base64.encode(raw.binary())
    lines.push("  \"" + b64 + "\",")
  }
  lines.push("]")
  lines.push("")
  let content = lines.join("\n")
  // 确保输出目录存在
  let parent = dirname(output)
  if !@fs.exists(parent) { @fs.mkdir(parent, recursive=true) }
  @fs.write_file(output, content, create_mode=@fs.CreateOrTruncate)
  @stdio.stderr.write("generated " + output + ": " + files.length().to_string() + " files\n")
}

async fn collect_files(dir : String) -> Array[String] {
  let result : Array[String] = []
  let entries = @fs.readdir(dir, sort=true)
  for entry in entries {
    let full = dir + "/" + entry
    if @fs.kind(full) is @fs.Directory {
      let sub = collect_files(full)
      for s in sub { result.push(s) }
    } else {
      result.push(full)
    }
  }
  result
}

fn relativize(base : String, path : String) -> String {
  let bl = base.length()
  if path.length() > bl && path[:bl] == base {
    let rest = path[bl:]
    if rest.length() > 0 {
      let r = if rest[0] == '/' { rest[1:] } else { rest }
      r.to_owned()
    } else {
      ""
    }
  } else {
    path
  }
}

fn dirname(p : String) -> String {
  match p.rev_find("/") {
    Some(i) => p[:i].to_owned()
    None => "."
  }
}
