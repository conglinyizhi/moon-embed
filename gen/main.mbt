async fn main {
  let args = @env.args()
  // args: ["moon", "run", "-p", "gen", "--", "<dist-dir>"]
  let mut dist = ""
  let mut found_sep = false
  for i = 0; i < args.length(); i = i + 1 {
    if args[i] == "--" { found_sep = true } else if found_sep { dist = args[i]; break }
  }
  if dist.is_empty() {
    @stdio.stderr.write("usage: moon run gen -- <dist-dir>\n")
    return
  }
  if !@fs.exists(dist) || !(@fs.kind(dist) is @fs.Directory) {
    @stdio.stderr.write("error: directory not found: " + dist + "\n")
    return
  }
  let files = collect_files(dist)
  @stdio.stdout.write("// Code generated by moon-embed/gen; DO NOT EDIT.\n")
  @stdio.stdout.write("// Source: " + dist + "\n\n")
  @stdio.stdout.write("pub let EMBED_PATHS : Array[String] = [\n")
  for f in files {
    let rel = relativize(dist, f)
    @stdio.stdout.write("  \"/" + rel + "\",\n")
  }
  @stdio.stdout.write("]\n\n")
  @stdio.stdout.write("pub let EMBED_DATA : Array[String] = [\n")
  for f in files {
    let raw = @fs.read_file(f)
    let b64 = @base64.encode(raw.binary())
    @stdio.stdout.write("  \"" + b64 + "\",\n")
  }
  @stdio.stdout.write("]\n")
}

async fn collect_files(dir : String) -> Array[String] {
  let result : Array[String] = []
  let entries = @fs.readdir(dir, sort=true)
  for entry in entries {
    let full = dir + "/" + entry
    if @fs.kind(full) is @fs.Directory {
      let sub = collect_files(full)
      for s in sub { result.push(s) }
    } else {
      result.push(full)
    }
  }
  result
}

fn relativize(base : String, path : String) -> String {
  let bl = base.length()
  if path.length() > bl && path[:bl] == base {
    let rest = path[bl:]
    if rest.length() > 0 {
      let r = if rest[0] == '/' { rest[1:] } else { rest }
      r.to_owned()
    } else {
      ""
    }
  } else {
    path
  }
}
